# Google / Gemini: non-secret Vertex AI runtime settings. Use ADC, not an API key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=

# Gemini Enterprise Agent Platform: object-style AdkApp is selected for the
# Tokyo runtime. Do not reuse the local global inference location here. Keep the
# dedicated staging bucket blank until it has been explicitly created.
AGENT_PLATFORM_LOCATION=asia-northeast1
AGENT_PLATFORM_STAGING_BUCKET=
# Full resource name of the already-created synthetic Runtime. This is not a
# credential, but keep the real project-specific value in the ignored .env.
AGENT_PLATFORM_RUNTIME_NAME=

# Google Maps Platform: local browser map only. Restrict the real key to
# Maps JavaScript API and http://127.0.0.1:8765/* during local development.
GOOGLE_MAPS_API_KEY=

# Box MCP: not used on Day 1. Obtain these from Box developer settings before live connection.
BOX_MCP_URL=https://mcp.box.com
BOX_MCP_NAME=box-remote-mcp
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_OAUTH_REDIRECT_URI=
BOX_OAUTH_SCOPES=Content Actions

# Local development
RIDE_ENV=development
# `local` is loopback-only and allows explicitly triggered cloud checks.
# `public_demo` may bind publicly but disables private GPX and all cloud actions.
RIDE_WEB_MODE=local
RIDE_WEB_HOST=127.0.0.1
RIDE_WEB_PORT=8765
# Japanese remains the development default. Set this to en only for an
# English-first submission/demo environment; the language query overrides it.
RIDE_UI_DEFAULT_LANGUAGE=ja
# Public repository root shown by the hosted demo. Leave blank until the
# reviewed repository exists. HTTPS GitHub/GitLab/Bitbucket URLs only.
RIDE_SOURCE_REPOSITORY_URL=
